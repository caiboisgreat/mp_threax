{
    // C/C++ IntelliSense 配置
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.configurationProvider": "candycium.keil-assistant-new",
    
    // 文件关联
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "stm32f4xx_hal_conf.h": "c",
        "tx_user.h": "c"
    },
    
    // 排除不必要的文件索引以提高性能
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "MDK-ARM/mp_threadx/*.d": true,
        "MDK-ARM/mp_threadx/*.o": true,
        "MDK-ARM/mp_threadx/*.crf": true,
        "MDK-ARM/mp_threadx/*.lst": true,
        "MDK-ARM/DebugConfig": true
    },
    
    // 搜索排除
    "search.exclude": {
        "**/node_modules": true,
        "**/*.d": true,
        "**/*.o": true,
        "**/*.crf": true,
        "**/*.lst": true,
        "MDK-ARM/RTE": true
    }
}
